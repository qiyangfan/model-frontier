{
  "name": "model-frontier",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_USE_ENV_PROXY=1 node server/index.mjs --dev",
    "build": "vite build",
    "start": "NODE_USE_ENV_PROXY=1 node server/index.mjs",
    "refresh": "NODE_USE_ENV_PROXY=1 node server/refresh-cli.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "test:e2e:fixture": "node tests/e2e-fixture.mjs",
    "test:portal": "node tests/portal-e2e.mjs",
    "test:evidence": "node tests/evidence-e2e.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 .",
    "lint:css": "stylelint 'src/**/*.css'",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=92 --test-coverage-branches=85 --test-coverage-functions=90 tests/*.test.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "antd": "6.6.6",
    "cheerio": "1.2.0",
    "csv-parse": "7.0.3",
    "echarts": "6.1.0",
    "hyparquet": "1.31.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "8.3.4"
  }
}
